<div class="container my-5">

  <h3 class="mb-4">Campaign Details</h3>
 
  <div class="row">
    <!-- LEFT SIDE: Form -->
    <div class="col-md-6">
      <%= form_with model: @campaign, url: dashboard_campaigns_path, method: :create do |f| %>

        <div class="mb-3">
          <%= f.label :name, class: "form-label" %>
          <%= f.text_field :name, class: "form-control" %>
        </div>
    
        <%= f.submit "Save Campaign", class: "btn btn-primary" %>

      <% end %>

      <div class="mt-4">
        <%= link_to "Back", dashboard_campaigns_path(campaign_id: @campaign_id), class: "btn btn-secondary" %>
      </div>
    </div>
  </div>
</div>
