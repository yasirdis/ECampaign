<div class="mt-5 container">
    <h1> Campaigns</h1>
    <%= link_to new_dashboard_campaign_path, class:  "btn btn-primary btn-lg" do %>
            <i class="bi bi-file-earmark-plus-fill"></i> Create New
        <% end %>
    <div class="row row-cols-1 row-cols-md-3 g-4 mt-5">
        <% @campaigns.each do |campaign| %>
                <div class="col">
                    <div class="card h-100">
                        <%# <img src="..." class="card-img-top" alt="..."> %>
                        <div class="card-body">
                            <h5 class="card-title"><%= campaign.name %></h5>
                        </div>
                             <%= link_to dashboard_campaign_templates_path(campaign_id: campaign.id), class: "btn btn-primary m-1" do %>
                                Open Templates
                             <% end %>
                    </div>
                </div>
        <% end %>
    </div>
</div>