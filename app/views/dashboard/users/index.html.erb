<div class="container">
  <div class="m-5">
      <h1>Dashboard Users</h1>

      <table class="table table-hover">
        <thead>
          <tr>
            <th scope="col">Profile Image</th>
            <th scope="col">Name</th>
            <th scope="col">Contact Number</th>
            <th scope="col">Logged From IP</th>
            <th scope="col">Last Logged In At</th>
            <th scope="col">Highest Access Roles</th>
          </tr>
        </thead>
        <tbody>
 
      <% @users.each do |user| %>

          <tr>
            <th scope="row"><img src="https://cdn-icons-png.flaticon.com/512/149/149071.png" class="rounded-circle float-left h-1 w-1" style="width: 40px; height: 40px;" alt="..."></th>
            <td><%=user.name%></td>
            <td><%=user.phone%></td>
            <td><%=user.logged_in_from_ip%></td>
            <td><%=user.last_logged_in_at%></td>
            <td><%=user.highest_access_role %></td>
          </tr>

      <% end %>
        </tbody>
      </table>
    <!--</div>-->
  </div>
</div>

