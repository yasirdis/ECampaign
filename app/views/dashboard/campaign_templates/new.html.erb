<div class="container">
  <div class="m-5">
    <%= form_with model: @campaign_template, url: dashboard_campaign_templates_path, 
              method: :post do |f| %>
    <div class="mb-3">
      <%= f.label :name, "NAME" ,class: "form-label" %>
      <%= f.text_field :name, class: "form-control" %>
    </div>

    <div>
      <%= f.label :html_code, "HTML Code", class: "form-label" %>
      <%= f.text_area :html_code, rows: 10, class: "form-control" %>
    </div>

    <div>
      <%= f.label :css_code, "CSS Code", class:"form-label" %>
      <%= f.text_area :css_code, rows: 5, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.label :campaign_id, "campaign_id" ,class: "form-label" %>
      <%= f.text_field :campaign_id, class: "form-control" %>
    </div>

    <div class="mt-4">
      <%= f.submit "Create Template", class: "btn btn-primary" %>
    </div>
    <% end %>
  </div>
</div>
