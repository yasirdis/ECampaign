<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- ... -->
    <script src="https://unpkg.com/@grapesjs/studio-sdk/dist/index.umd.js"></script>
    
    <link rel="stylesheet" href="https://unpkg.com/@grapesjs/studio-sdk/dist/style.css"/>
  </head>
  <body class="m-5">
    <div id="studio-editor" style="height: 100dvh"></div>
    <script>
      GrapesJsStudioSDK.createStudioEditor({
        root: '#studio-editor',
        licenseKey: 'cd82c3ee981648b99bf284a42c01c514cd454afd59744cd8884e723c0c972ad7',
        theme: 'light',
        project: {
          type: 'email'
        },
        assets: {
          storageType: 'self',
          // Provide a custom upload handler for assets
          onUpload: async ({ files }) => {
            const body = new FormData();
            for (const file of files) {
              body.append('files', file);
            }
            alert("ssssssss");
            const response = await fetch('/dashboard/campaign_templates/<%= @campaign_template.id %>/save_asset', { method: 'POST', body });
            const result = await response.json();
            // The expected result should be an array of assets, eg.
            // [{ src: 'ASSET_URL' }]
            return result;
          },
          // Provide a custom handler for deleting assets
          onDelete: async ({ assets }) => {
            const body = JSON.stringify(assets);
                             
            await fetch("<%= save_asset_dashboard_campaign_template_path(@campaign_template.id) %>", { method: "POST", body });
          }
        },
        storage: {
          type: 'self',
          // Provide a custom handler for saving the project data.
          onSave: async ({ project }) => {
            const csrfToken = document.querySelector('meta[name="csrf-token"]').content;

            // throw new Error('Implement your "onSave"!');
            const body = new FormData();
            body.append('project', JSON.stringify(project));
            // await fetch('<%= save_asset_dashboard_campaign_template_path(@campaign_template.id) %>', { method: 'POST', body });
            await fetch('<%= save_asset_dashboard_campaign_template_path(@campaign_template.id) %>', {
              method: 'POST',
              headers: {
                'X-CSRF-Token': csrfToken
              },
              body
            });
          },
          // Provide a custom handler for loading project data.
          onLoad: async () => {
            throw new Error('Implement your "onLoad"!');
            const response = await fetch('/dashboard/campaign_templates/<%= @campaign_template.id %>/project_load');
            const project = await response.json();
            // The project JSON is expected to be returned inside an object.
            return { project };
          },
          autosaveChanges: 100,
          autosaveIntervalMs: 10000
        }
      });
    </script>
  </body>
</html>