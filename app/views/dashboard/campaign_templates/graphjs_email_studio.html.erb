<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- ... -->
    <script src="https://unpkg.com/@grapesjs/studio-sdk/dist/index.umd.js"></script>
    
    <link rel="stylesheet" href="https://unpkg.com/@grapesjs/studio-sdk/dist/style.css"/>
  </head>
  <body class="m-5">
    <div id="studio-editor" style="height: 100dvh"></div>
    <script>
      GrapesJsStudioSDK.createStudioEditor({
        root: '#studio-editor',
        licenseKey: 'cd82c3ee981648b99bf284a42c01c514cd454afd59744cd8884e723c0c972ad7',
        theme: 'light',
        project: {
          type: 'email'
        },
        assets: {
          storageType: 'self',
          // Provide a custom upload handler for assets
          onUpload: async ({ files }) => {  
            const body = new FormData();
            const csrfToken = document.querySelector('meta[name="csrf-token"]').content;
            for (const file of files) {
              body.append('files', file);
            }
            const response = await fetch(
              "<%= save_asset_dashboard_campaign_template_path(@campaign_template) %>",
              {
                method: "POST",
                headers: {
                  "X-CSRF-Token": csrfToken
                },
                body
              }
            );
            const result = await response.json();
            // The expected result should be an array of assets, eg.
            // [{ src: 'ASSET_URL' }]
            return result;
          },
          // Provide a custom handler for deleting assets
          onDelete: async ({ assets }) => {
            const csrfToken = document.querySelector('meta[name="csrf-token"]').content;
            const body = JSON.stringify(assets);
                             
            await fetch("<%= destroy_asset_dashboard_campaign_template_path(@campaign_template.id) %>",
            { method: "POST", body,
              headers: {
                "X-CSRF-Token": csrfToken,
              }
            });
          }
        },
        storage: {
          type: 'self',
          // Provide a custom handler for saving the project data.
          onSave: async ({ editor, project }) => {
            const mjml = editor.getHtml();
            // const css = editor.getCss();
            const csrfToken = document.querySelector('meta[name="csrf-token"]').content;

            // throw new Error('Implement your "onSave"!');
            const body = new FormData();
            body.append('project', JSON.stringify(project));
            body.append('mjml', mjml);
            // await fetch('<%= save_asset_dashboard_campaign_template_path(@campaign_template.id) %>', { method: 'POST', body });
            await fetch('<%= template_save_dashboard_campaign_template_path(@campaign_template.id) %>', {
              method: 'POST',
              headers: {
                'X-CSRF-Token': csrfToken
              },
              body
            });
          },
          // Provide a custom handler for loading project data.
          onLoad: async () => {
            const csrfToken = document.querySelector('meta[name="csrf-token"]').content;
            const response = await fetch('<%= project_load_dashboard_campaign_template_path(@campaign_template.id) %>', {
              method: 'GET',
              headers: {
                'X-CSRF-Token': csrfToken
              }
            });
            const result = await response.json();
            console.log("Loaded project data:", result);
            // The project JSON is expected to be returned inside an object.
            return { project: result.project };
          },
          autosaveChanges: 100,
          autosaveIntervalMs: 10000
        }
      });
    </script>
  </body>
</html>